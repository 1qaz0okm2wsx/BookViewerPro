:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  line-height: 1.6;
  font-weight: 400;
  color: #1f2937;
  background: #f3f4f6;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
}

body {
  min-height: 100vh;
}

button, input {
  font: inherit;
}

* {
  box-sizing: border-box;
}

.app {
  display: flex;
  min-height: 100vh;
  background: #f8fafc;
  color: #111827;
}

.sidebar {
  width: 320px;
  border-right: 1px solid #e5e7eb;
  background: #ffffff;
  padding: 24px 18px;
}

.brand-row h1 {
  margin: 0 0 20px;
  font-size: 1.8rem;
}

.library-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
  font-weight: 600;
}

.upload-button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 12px;
  border-radius: 10px;
  background: #2563eb;
  color: white;
  cursor: pointer;
  font-size: 0.8rem;
}

.upload-button input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}

.book-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.book-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: 12px;
  background: #f3f4f6;
  cursor: pointer;
  transition: all 0.2s ease;
}

.book-item:hover,
.book-item.active {
  background: #dbeafe;
}

.book-item .cover {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  background: #ffffff;
  border-radius: 10px;
  font-size: 1.4rem;
}

.book-item strong,
.book-item small {
  display: block;
}

.book-item small {
  color: #6b7280;
}

.reader-panel {
  flex: 1;
  padding: 32px 30px;
}

.reader-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 16px;
}

.reader-toolbar h2 {
  margin: 0;
  font-size: 2rem;
}

.reader-toolbar p {
  margin: 6px 0 0;
  color: #6b7280;
}

.controls {
  display: flex;
  align-items: center;
  gap: 10px;
}

.controls button {
  border: 0;
  background: #e5e7eb;
  color: #111827;
  padding: 10px 14px;
  border-radius: 10px;
  cursor: pointer;
}

.controls button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.progress-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.progress-bar {
  flex: 1;
  height: 10px;
  border-radius: 999px;
  background: #e5e7eb;
  overflow: hidden;
}

.progress-bar span {
  display: block;
  height: 100%;
  background: linear-gradient(90deg, #2563eb, #60a5fa);
  border-radius: inherit;
}

.book-article {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  padding: 28px;
  max-width: 1100px;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.05);
}

.book-article h3 {
  margin: 0 0 18px;
  font-size: 1.6em;
}

.book-article p {
  margin: 0 0 18px;
  color: #1f2937;
}

.app.dark {
  background: #0f172a;
  color: #e2e8f0;
}

.app.dark .sidebar,
.app.dark .book-article {
  background: #111827;
  border-color: #334155;
}

.app.dark .book-item,
.app.dark .controls button,
.app.dark .progress-bar {
  background: #1f2937;
  color: #e2e8f0;
}

.app.dark .book-item small,
.app.dark .reader-toolbar p,
.app.dark .book-article p {
  color: #cbd5e1;
}

@media (max-width: 900px) {
  .app {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid #e5e7eb;
  }

  .reader-toolbar {
    flex-direction: column;
    align-items: flex-start;
  }
}
